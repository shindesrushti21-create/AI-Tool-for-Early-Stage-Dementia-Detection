# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dementia_screening

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ─── SLA ─────────────────────────────────────────────────────────────────────
# Log a warning when any endpoint exceeds this threshold (milliseconds)
RESPONSE_TIME_SLA_MS=300

# ─── NGO Details (used by /api/schema/organization and /api/content/location) ─
NGO_NAME=CogniCare Foundation
NGO_ADDRESS=12, Health Avenue, Pune, Maharashtra 411001, India
NGO_LAT=18.5204
NGO_LNG=73.8567
NGO_PHONE=+91-20-12345678
NGO_EMAIL=info@cognicare.org
NGO_URL=https://cognicare.org
