# Full-Stack Application Environment Variables

# Frontend Config
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Server Config
PORT=5000
NODE_ENV=development
RESPONSE_TIME_SLA_MS=300

# Backend PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dementia_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dementia_db

# Security & JWT
JWT_SECRET=super-secret-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d
